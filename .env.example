# Database Connection
# NOTE: Use standard connection string format instead of mongodb+srv:// if encountering DNS issues.
# For full setup guide, see: docs/engineering-runbook.md#environment-variables
MONGODB_URI="mongodb://user:pass@shard-00-00.domain.net:27017,shard-00-01.domain.net:27017/db_name?ssl=true&replicaSet=atlas-xxx&authSource=admin"

# Node Environment
NODE_ENV="development"

# JWT Configuration (Generates a strong secret: openssl rand -base64 32)
JWT_ACCESS_SECRET="your_at_least_32_character_jwt_access_secret_here"
JWT_REFRESH_SECRET="your_at_least_32_character_jwt_refresh_secret_here"

# Optional JWT Expirations
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"