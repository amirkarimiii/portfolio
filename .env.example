# Environment Variables Guide:
# docs/environment.md

# Database Connection
# See the Environment Variables guide for connection string recommendations.
MONGODB_URI="mongodb://user:pass@shard-00-00.domain.net:27017,shard-00-01.domain.net:27017/db_name?ssl=true&replicaSet=atlas-xxx&authSource=admin"

# Node Environment (development | production | test)
NODE_ENV="development"

# JWT Configuration (Generate a secure secret with: openssl rand -base64 32)
JWT_ACCESS_SECRET="your_at_least_32_character_jwt_access_secret_here"
JWT_REFRESH_SECRET="your_at_least_32_character_jwt_refresh_secret_here"

# Optional JWT Expiration Times (defaults: 15m and 7d)
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# Rate Limiting Configuration (defaults: 5 attempts per 15 minutes)
MAX_LOGIN_ATTEMPTS=5
LOGIN_RATE_LIMIT_WINDOW_MS=900000

# Logging Configuration (trace | debug | info | warn | error | fatal)
# Default: 'debug' in development, 'info' in production
LOG_LEVEL="debug"

# Vercel OIDC Token
# Automatically provided by Vercel when OIDC Federation is enabled.
# Available at build time. In local development, obtain it with:
#   vercel link
#   vercel env pull
# Do not hardcode a real token here. Leave empty or omit in pure local setups.
VERCEL_OIDC_TOKEN=""

# Vercel Blob
# BLOB_STORE_ID: The unique identifier of your Vercel Blob store.
# BLOB_WEBHOOK_PUBLIC_KEY: Public key used to verify incoming Blob webhook signatures.
# Both are typically provided by Vercel when Blob is configured.
# Leave empty if Blob is not used in the current environment.
BLOB_STORE_ID=""
BLOB_WEBHOOK_PUBLIC_KEY=""